# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env com segredos.

# Backend / Banco
DB_HOST=banco
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=projeto5p
MYSQL_ROOT_PASSWORD=troque_esta_senha
JWT_SECRET=troque_por_uma_chave_longa_e_unica

# Gamificação (conquistas-service) - banco "gamificacao" e usuário próprio,
# criados por banco/init/01-gamificacao.sh na primeira subida do MySQL.
# Use os mesmos valores em DB_USER/DB_PASSWORD do conquistas-service/.env.
GAMIFICACAO_DB_USER=gamificacao
GAMIFICACAO_DB_PASSWORD=troque_esta_senha

# APIs externas
GOOGLE_BOOKS_API_KEY=coloque_sua_chave_aqui
