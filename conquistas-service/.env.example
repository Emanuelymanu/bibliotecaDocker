NODE_ENV=development
PORT=3001


DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamificacao
DB_USER=gamificacao
DB_PASSWORD=exemplosenha
JWT_SECRET=copie_a_mesma_do_env_da_raiz

# Cache do catálogo (GDL-10). Fora do Docker: redis://localhost:6379 (precisa do docker-compose.dev.yml)
# Dentro do docker-compose: redis://redis:6379. Sem esta variável, o cache fica em memória.
REDIS_URL=redis://localhost:6379
CACHE_TTL_SEGUNDOS=300